{
  "name": "resume",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "clear && npm run clear && npm run tailwind-cli && npm run css-copy && next dev --turbo",
    "clear": "rm -rf ./.next && npm run empty-files",
    "empty-files": "truncate -s 0 ./src/app/globals.css && truncate -s 0 ./dist/styles/globals.css",
    "next": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "publish": "gh-pages -d src/public -b source --repo https://git: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@github.com/climoe/climoe.github.io.git",
    "prettier-format": "prettier --write 'src/components/**/*.tsx' 'src/app/**/*.tsx",
    "prettier-check": "prettier --check 'src/components/**/*.tsx' 'src/app/**/*.tsx",
    "tailwind-cli": "npx @tailwindcss/cli -i ./src/styles/style.css -o ./dist/styles/globals.css",
    "css-copy": "cp ./dist/styles/globals.css ./src/app/globals.css"
  },
  "keywords": [
    "nextjs",
    "react",
    "tailwindcss",
    "turbopack"
  ],
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.10",
    "@phosphor-icons/react": "^2.1.10",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/cli": "^4.1.12",
    "@tailwindcss/postcss": "^4.3.3",
    "browser-refresh-taglib": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "gh-pages": "^6.3.0",
    "gray-matter": "^4.0.3",
    "motion": "^13.2.0",
    "next": "16.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-intersection-observer": "^11.0.0",
    "react-to-print": "^3.3.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prettier": "3.9.6",
    "typescript": "^5"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true,
    "@parcel/watcher@2.6.0": true,
    "@tailwindcss/oxide@4.1.12": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
